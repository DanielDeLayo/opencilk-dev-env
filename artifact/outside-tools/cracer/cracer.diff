+RUNTIME_LIB = $(CRACER_W)/rts/lib/x86_64/libcilkrts.a
+OPT_FLAG = -O3 -DSTATS=0 -flto
+TOOL_DEBUG = 0
+MALLOC = -ltcmalloc
+LDFLAGS += -flto
+ARFLAGS = --plugin $(COMPILER_HOME)/lib/LLVMgold.so
