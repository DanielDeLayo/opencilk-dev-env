-  Printf("\nDPST Statistics:\n");
-  for (u32 i = 0; i < NODE_TYPE_END; i++) {
-    Printf("%s nodes: %u\n", node_desc[i], node_counts[i]);
-    num_nodes += node_counts[i];
-  }
-  Printf("Total number of nodes: %u\n", num_nodes);
-  Printf("Max depth: %d\n", max_depth);
-  Printf("=============================================================\n");
-}
