{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Opencilk",
            "type": "shell",
            // Assign output file name with VSCode inner variables like ${fileBasename}
            "command": "${workspaceFolder:opencilk}/../infrastructure/tools/build ${workspaceFolder:opencilk} ${workspaceFolder:opencilk}/build",
            "options": {
                "cwd": "${workspaceFolder:opencilk}/build",
                "env": {
                    "OPENCILK_RUNTIMES": "cheetah;cilktools;cheetah_debug;cilktools_debug"
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build Opencilk",
            "type": "shell",
            // Assign output file name with VSCode inner variables like ${fileBasename}
            "command": "make -j 4",
            "options": {
                "cwd": "${workspaceFolder:opencilk}/build"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "CMake Examples",
            "type": "shell",
            "command": "${workspaceFolder:cilktools}/cilkprace/race_detection_examples/tools/build.sh -j 4 ${workspaceFolder:opencilk}/build ${workspaceFolder:cilktools}/cilkprace/race_detection_examples/build",
            "options": {
                "cwd": "${workspaceFolder:cilktools}/cilkprace/race_detection_examples"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build Examples",
            "type": "shell",
            "command": "make -j 4",
            "options": {
                "cwd": "${workspaceFolder:cilktools}/cilkprace/race_detection_examples/build"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Run Timing Tests",
            "type": "shell",
            "command": "make time",
            "options": {
                "cwd": "${workspaceFolder:cilktools}/cilkprace/race_detection_examples/build"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "Run Cilkprace Timing Tests",
            "type": "shell",
            "command": "make cilkprace.time",
            "options": {
                "cwd": "${workspaceFolder:cilktools}/cilkprace/race_detection_examples/build"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "Test Examples And Build",
            "dependsOn": [
                "Build Opencilk",
                "CMake Examples",
                "Build Examples",
                "Run Timing Tests"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "test",
                "isDefault": true
            }
        }
    ]
}