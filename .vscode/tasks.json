{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Opencilk",
            "type": "shell",
            // Assign output file name with VSCode inner variables like ${fileBasename}
            "command": "make -j 4",
            "options": {
              "cwd": "${workspaceFolder}/../opencilk-project/build"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build Examples",
            "type": "shell",
            // Assign output file name with VSCode inner variables like ${fileBasename}
            "command": "make -B blah.notool",
            "options": {
              "cwd": "${workspaceFolder}/../opencilk-project/cilkprace/race_detection_examples"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
